<Window x:Class="Lab_03.Views.CategoryOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_03.Views"
        mc:Ignorable="d"
        Title="Category Options" Height="400" Width="300" ResizeMode="NoResize" >
    <Grid>
        <StackPanel Orientation="Vertical">
            <Label Content="Add Category:" />
            <TextBox Name="CategoryTextBox" Margin="5" TextAlignment="Center" />
            <Button Name="AddCategoryButton" Content="Add to Categories" Margin="60 20" Padding="20 5" Click="AddToCategories_Click"/>
            <Line StrokeThickness="1" Stroke="Black" X2="300" Margin="10 40"/>
            <Label Content="Remove from Categories:" />
            <ComboBox Name="CategoryComboBox" Margin="5" SelectedIndex="0" ItemsSource="{Binding Categories}" />
            <Button Name="RemoveCategoryButton" Content="Remove from Categories" Margin="60 20" Padding="20 5" Click="RemoveFromCategories_Click"/>
        </StackPanel>
    </Grid>
</Window>